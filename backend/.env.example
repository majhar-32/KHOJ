# Server Port
PORT=5000

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Connection URL (pooled, for application)
DATABASE_URL=

# Direct Database URL (direct connection, for migrations)
DIRECT_URL=

# JWT Secret Key (will be used starting Phase B3)
JWT_SECRET=

# Cloudinary Configuration (for Phase B7 image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini API Key (for Phase B8 AI integration)
GEMINI_API_KEY=your_gemini_api_key

# Pexels API Key (for auto-assigning stock banners)
PEXELS_API_KEY=your_pexels_api_key
